#!/usr/bin/env bash
# Pre-commit hook: warns when Cargo.toml or Cargo.lock is staged without a
# corresponding update to vendor.tar.xz.
#
# This is a warning-only hook — it never blocks the commit.
# The vendor-sync job in ci.yml will fail the build if there is a real mismatch.
#
# Install: git config core.hooksPath .githooks
# (or run: bash scripts/internal/install-hooks.sh)

CARGO_CHANGED=$(git diff --cached --name-only 2>/dev/null | grep -E 'Cargo\.(toml|lock)$' || true)
VENDOR_CHANGED=$(git diff --cached --name-only 2>/dev/null | grep -E 'vendor\.tar\.xz(\.sha256)?$' || true)

# ── Hard block: never allow private-key / cert-bundle material to be committed ──
# (F-01) Matches by extension and by filename anywhere in the tree. This is a
# blocking check — unlike the vendor warning below — because a leaked signing key
# cannot be un-leaked once pushed.
KEY_MATERIAL=$(git diff --cached --name-only --diff-filter=AM 2>/dev/null \
    | grep -E '\.(key|pem|pfx|p12|jks|keystore|asc)$|(^|/)id_rsa($|\.)|(^|/)id_ed25519($|\.)' \
    || true)
if [ -n "$KEY_MATERIAL" ]; then
    echo "" >&2
    echo "  ✗ COMMIT BLOCKED — private-key / certificate material is staged:" >&2
    echo "$KEY_MATERIAL" | sed 's/^/      /' >&2
    echo "" >&2
    echo "  Key material must never be committed. Move it outside the repo tree" >&2
    echo "  (e.g. ~/.sloc-signing/) or store it in a KMS/HSM. If this is a test" >&2
    echo "  fixture that is genuinely safe, commit with: git commit --no-verify" >&2
    echo "" >&2
    exit 1
fi

if [ -n "$CARGO_CHANGED" ] && [ -z "$VENDOR_CHANGED" ]; then
    echo ""
    echo "  ┌─────────────────────────────────────────────────────────────────┐"
    echo "  │  WARNING: Cargo.toml/Cargo.lock changed — vendor.tar.xz not    │"
    echo "  │  If you added, removed, or updated a dependency, run:           │"
    echo "  │    bash scripts/internal/update-vendor.sh                      │"
    echo "  │    git add vendor.tar.xz vendor.tar.xz.sha256                  │"
    echo "  │  Version-only bumps (no dep changes) can ignore this warning.  │"
    echo "  │  CI will fail if vendor.tar.xz is actually out of sync.         │"
    echo "  └─────────────────────────────────────────────────────────────────┘"
    echo ""
fi

exit 0
