# Build output
/target/

# Uncompressed vendor sources — always extract from vendor.tar.xz; never commit the directory
/vendor/

# .cargo/config.toml is written by CI (Jenkinsfile) and local airgap scripts; not committed
# so that online dev builds continue to use crates.io by default.
/.cargo/config.toml

# Logs and temp files
*.log
*.tmp
*.bak
/logs/

# OS artefacts
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# Secrets / local env
.env
ci/jenkins/.env

# Local setup notes — not for publication
sonarqube-manual-setup.md

# Signing cert generation output — private keys and PFX bundles, never committed
/_signing/

# Local test output (not for commit)
out/
out.7z
tmp-sloc/

# Loose report artefacts from local runs
result.json
result.html
result.pdf

# Clippy machine-readable output (generated by CI/SonarQube scripts)
clippy.json
clippy-sonar.json
clippy.stderr

# Coverage / profiling (cargo-llvm-cov, grcov, cargo-flamegraph)
*.profraw
*.profdata
lcov.info
flamegraph.svg
perf.data
perf.data.old

# Compiled binaries — never committed; users build from toolchain/ + vendor sources
*.exe
*.dll

# dist/ — ignored for local builds to prevent accidental commits.
# update-dist.yml uses `git add -f` to intentionally commit the signed
# Windows zip (oxide-sloc-windows-x64.zip) after each release.
/dist/

# toolchain/ — bundled Rust toolchain archives (7-zip level 9, split into ≤45 MB parts)
# committed by maintainers via bundle-rust-toolchain.sh. Only ignore temp extraction dirs.
/toolchain/tmp/
/.tools/

# Generated report artefacts under tests/fixtures/
tests/fixtures/**/sloc/

# Transferable bundle archives created by `make bundle`
/oxide-sloc-bundle*.7z
/oxide-sloc-bundle*.tar.gz

# Claude Code (project-local AI context — not for commit)
CLAUDE.md
.claude
