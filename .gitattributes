# Normalize all text files to LF on commit (no CRLF in the repo)
* text=auto eol=lf

# Explicitly mark known binary file types globally
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.tar.xz binary
*.tar.gz binary
*.7z binary
*.exe binary
*.wasm binary
*.o binary
*.a binary
*.lib binary
*.fst binary
*.dfa binary
*.der binary
# Jenkins plugin archives — committed as binary blobs
*.hpi binary
*.jpi binary

# ── Large binary archives — git LFS ──────────────────────────────────────────
# vendor.tar.xz (~35 MB) fits within GitHub's 100 MB limit — no LFS needed.
# Rust toolchain tarballs in toolchain/ are ~170-250 MB and REQUIRE git LFS.
# jenkins-plugins.tar.xz can exceed 100 MB depending on transitive deps.
#
# toolchain/ LFS tracking (active — run once per machine after clone):
#   git lfs install
#   git lfs pull    # fetches LFS objects for toolchain/ archives
#
# To add more LFS-tracked file patterns:
#   git lfs track 'jenkins-plugins.tar.xz'
#   git add .gitattributes
#
# If bundle-jenkins-plugins.sh warns that the archive exceeds 100 MB, run the
# above commands before committing jenkins-plugins.tar.xz.

# Rust toolchain installer tarballs — stored in git LFS (200-250 MB each)
toolchain/*.tar.gz  filter=lfs diff=lfs merge=lfs -text
toolchain/*.tar.xz  filter=lfs diff=lfs merge=lfs -text

# Vendor sources must never be normalized by git — cargo checksum verification
# compares the exact bytes on disk to the SHA-256 in .cargo-checksum.json.
# If git rewrites CRLF→LF (or vice-versa) in any vendor file, the checksum
# will not match and cargo will refuse to build.  Use -text to disable all
# line-ending processing for every file under vendor/.
vendor/** -text

# Our own source and static assets: normalize to LF
crates/**/*.rs   text eol=lf
crates/**/*.toml text eol=lf
crates/**/*.json text eol=lf
crates/sloc-web/static/*.js text eol=lf
