# Normalize all text files to LF on commit (no CRLF in the repo)
* text=auto eol=lf

# Belt-and-suspenders: force LF for executable scripts regardless of content
# sniffing. On Windows with core.autocrlf=true a CRLF-checked-out .sh is a hard
# failure in Git Bash ("bad interpreter", "\r: command not found"), and the
# Jenkins pipeline executes these scripts through Git Bash on Windows agents.
*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
*.groovy text eol=lf

# Explicitly mark known binary file types globally
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.tar.xz binary
*.tar.gz binary
*.7z binary
*.exe binary
*.wasm binary
*.o binary
*.a binary
*.lib binary
*.fst binary
*.dfa binary
*.der binary
# Jenkins plugin archives — committed as binary blobs
*.hpi binary
*.jpi binary

# ── Large binary archives ────────────────────────────────────────────────────
# All archives are committed directly to git.
# 7-zip ultra (level 9) + split at 45 MB keeps every committed file within
# GitHub's per-file limit.
#
# vendor.tar.gz.aa/.ab/.ac  ≤45 MB per part — Rust crate sources, gzip-compressed
#                            (split so no single file exceeds GitHub's 100 MB limit;
#                             gzip so stock Git Bash on Windows can extract it — no xz)
# toolchain/           ≤45 MB per part — Rust toolchain split parts
# jenkins-plugins.tar.xz — varies; rebuild with bundle-jenkins-plugins.sh if needed

# Vendor crate-source archive — split gzip parts at repo root, binary blobs
vendor.tar.gz.*       binary

# Rust toolchain archives — binary blobs, committed directly
# Parts produced by bundle-rust-toolchain.sh: *.tar.gz.aa, *.tar.gz.ab, …
toolchain/*.tar.gz    binary
toolchain/*.tar.xz    binary
toolchain/*.tar.gz.*  binary

# ── Packing efficiency ───────────────────────────────────────────────────────
# These archives are already compressed (xz/gz/7z/zip) and high-entropy, so git
# never finds useful deltas — yet it still *attempts* delta-compression on every
# gc/repack/clone, wasting CPU. -delta skips that attempt (no size change; faster
# maintenance). Applies to the committed vendor/toolchain/dist blobs.
vendor.tar.gz.*       -delta
*.tar.xz              -delta
*.tar.gz              -delta
toolchain/*.tar.gz.*  -delta
*.zip                 -delta
*.7z                  -delta

# Vendor sources must never be normalized by git — cargo checksum verification
# compares the exact bytes on disk to the SHA-256 in .cargo-checksum.json.
# If git rewrites CRLF→LF (or vice-versa) in any vendor file, the checksum
# will not match and cargo will refuse to build.  Use -text to disable all
# line-ending processing for every file under vendor/.
vendor/** -text

# Our own source and static assets: normalize to LF
crates/**/*.rs   text eol=lf
crates/**/*.toml text eol=lf
crates/**/*.json text eol=lf
crates/sloc-web/static/*.js text eol=lf
