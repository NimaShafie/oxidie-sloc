# Configuration for oxide-sloc down/recovery email alerts.
#
# Install:  sudo install -m 0640 -o root -g oxide-sloc \
#             deploy/alert.env.example /etc/oxide-sloc/alert.env
#           then edit /etc/oxide-sloc/alert.env with real values.
#
# Both oxide-sloc-alert@.service (hard crash) and oxide-sloc-health.service
# (soft failure) load this via EnvironmentFile=. Keep it 0640, not world-readable
# — it contains the SMTP password.

# SMTP relay URL. Use smtps:// for implicit TLS (port 465) or smtp:// for
# STARTTLS (port 587). Reuse whatever relay your other services use.
ALERT_SMTP_URL=smtps://smtp.example.com:465

# Envelope + auth. ALERT_TO may be a single address; for multiple recipients,
# run the sender once per address or use a distribution list.
ALERT_FROM=oxide-sloc@example.com
ALERT_TO=ops@example.com
ALERT_SMTP_USER=oxide-sloc@example.com
ALERT_SMTP_PASS=change-me

# Optional overrides for the health probe (defaults shown):
# HEALTH_URL=http://127.0.0.1:4317/healthz
# HEALTH_TIMEOUT=10
