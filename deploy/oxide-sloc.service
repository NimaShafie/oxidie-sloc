[Unit]
Description=oxide-sloc source line analysis server
After=network.target

# Email when this service ends up in the failed state (crashed and systemd gave
# up restarting it). Requires oxide-sloc-alert@.service + /etc/oxide-sloc/alert.env.
# Soft failures (process alive but not serving) are caught separately by
# oxide-sloc-health.timer. Remove this line if you don't want crash emails.
OnFailure=oxide-sloc-alert@%n.service

[Service]
Type=simple
User=oxide-sloc
Group=oxide-sloc
WorkingDirectory=/opt/oxide-sloc

ExecStart=/usr/local/bin/oxide-sloc serve --server

Restart=on-failure
RestartSec=5

# All runtime config (bind address, API keys, TLS, CORS, rate limit, audit, …)
# comes from this env file. install-systemd.sh generates it with a random API key
# so the service is authenticated out of the box; base a fuller profile on
# deploy/corp.env.example. The leading '-' means "start even if the file is
# absent" — but note `serve --server` is fail-closed and will refuse to start
# unauthenticated unless the file provides SLOC_API_KEYS or SLOC_ALLOW_UNAUTHENTICATED=1.
EnvironmentFile=-/etc/oxide-sloc/oxide-sloc.env

# SELinux: binding the default port 4317 as this service works out of the box.
# If you switch to a privileged (<1024) or otherwise-unlabelled port, first run:
#   sudo semanage port -a -t http_port_t -p tcp <port>
# (and open it in firewalld: sudo firewall-cmd --add-port=<port>/tcp --permanent --reload)

# Point the server at the asset root (images/, etc.).
Environment=OXIDE_SLOC_ROOT=/opt/oxide-sloc

# Structured log level.  Change to 'debug' for troubleshooting.
Environment=RUST_LOG=info

# Override browser path if PDF export is needed and chromium is not in PATH.
# Environment=SLOC_BROWSER=/usr/bin/chromium

# Uncomment to store the scan registry on a separate volume/mount.
# Environment=SLOC_REGISTRY_PATH=/var/lib/oxide-sloc/registry.json

# Basic sandboxing — drop most Linux capabilities.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/oxide-sloc/out

[Install]
WantedBy=multi-user.target
